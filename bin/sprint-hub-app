#!/bin/bash
# Open sprint-hub as its own app window (Chromium --app). Starts hubd first if it is down: via its service if installed.
repo=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
url=http://127.0.0.1:8765

if ! curl -sf -m1 "$url/health" >/dev/null; then
  if systemctl --user cat hubd.service >/dev/null 2>&1; then
    systemctl --user start hubd.service  # hubd install-service made it
  else
    setsid uwsm-app -- uv run --project "$repo" hubd >/dev/null 2>&1 &
  fi
  for _ in $(seq 25); do
    curl -sf -m1 "$url/health" >/dev/null && break
    sleep 0.2
  done
  curl -sf -m1 "$url/health" >/dev/null || { notify-send -u critical "sprint-hub" "hubd did not start"; exit 1; }
fi

# Pattern = Hyprland window class of a Chrome --app window on this URL (`hyprctl clients`); \b in the matcher needs it to end on a letter.
exec omarchy-launch-or-focus-webapp chrome-127.0.0.1__-Default "$url"
